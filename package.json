{
  "name": "skill-packer",
  "version": "1.2.1",
  "description": "Download and package skills into .skill files",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "skill-packer": "./bin/cli.mjs",
    "pack-skill": "./bin/pack-skill.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "obuild",
    "dev": "node src/cli.ts",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "skill",
    "agent-skills",
    "ai-agents",
    "packaging"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rh42-ic/skill-packer.git"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fflate": "^0.8.3",
    "picocolors": "^1.1.1",
    "simple-git": "^3.27.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "obuild": "^0.4.22",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=18"
  }
}
